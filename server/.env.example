# Copy to .env for local work. A hosted API sets these in the host's dashboard instead.
# Nothing here is a real secret.

# development | production. In production every value marked "required" must be set.
NODE_ENV=development

# Port the API listens on. Hosts like Render and Railway set this themselves.
PORT=5000

# MongoDB connection string. Leave empty in development to use a throwaway in-memory database.
# Required in production. It must be a replica set (MongoDB Atlas is one), because payouts use transactions.
MONGO_URI=

# Signs login tokens. Required in production: at least 32 random characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Signs the bank's webhook calls. Required in production: at least 16 random characters.
BANK_WEBHOOK_SECRET=

# The web app's address. Only these origins may call the API from a browser. Required in production.
# Several can be separated by commas. No wildcards, no trailing slash, https in production.
CLIENT_URL=http://localhost:5173

# Load the demo users and data when the database is empty at start-up (true or false).
SEED_ON_EMPTY=true

# Password for the demo users. Required on a hosted database (production, or a mongodb+srv address) when SEED_ON_EMPTY is true.
# In development the demo password is Demo@1234.
DEMO_PASSWORD=

# How many proxies sit in front of the API, for correct client IPs in rate limiting.
# Defaults to 1 in production (Render, Railway) and 0 otherwise.
TRUST_PROXY=
