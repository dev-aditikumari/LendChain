# The API's address, for example https://lendchain-api.onrender.com (no trailing slash).
# Set it where the client is built (Vercel, Netlify). Leave it empty for local work:
# the dev server then forwards /api to http://localhost:5000.
VITE_API_URL=

# Shown on the sign-in page so visitors can log in. Must match DEMO_PASSWORD on the API.
# Defaults to Demo@1234 when empty.
VITE_DEMO_PASSWORD=
